{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"allowJs": true,
		"outDir": "./dist",
		"rootDir": ".",
		"rewriteRelativeImportExtensions": true,
		// The maps would point at src/ and test/, which the package does not ship.
		"sourceMap": false,
		"declarationMap": false
	},
	"include": ["core/**/*.ts", "src/**/*.ts"],
	"exclude": ["test", "migrations", "scripts", "examples", "node_modules", "dist"]
}
