		"**/*.ts",
		".automation/**/*.ts",
		"test/.legacy-unsupported/any-all-some-operators.test.ts",
		"test/.legacy-unsupported/apply-statements.test.ts",
		"test/.legacy-unsupported/array-functions.test.ts",
		"test/.legacy-unsupported/array-operators-extended.test.ts",
		"test/.legacy-unsupported/arrays-operators.test.ts",
		"test/.legacy-unsupported/bind-colon-params.test.ts",
		"test/.legacy-unsupported/bind-positional-params.test.ts",
		"test/.legacy-unsupported/check-sql-valid.test.ts",
		"test/.legacy-unsupported/fail-to-compile.ts",
		"test/.legacy-unsupported/function-registry.test.ts",
		"test/.legacy-unsupported/group-by.test.ts",
		"test/.legacy-unsupported/parse-alter-table.test.ts",
		"test/.legacy-unsupported/parse-create-schema.test.ts",
		"test/.legacy-unsupported/parse-create-table-array-types.test.ts",
		"test/.legacy-unsupported/parse-create-table-postgresql-types.test.ts",
		"test/.legacy-unsupported/parse-create-table.test.ts",
		"test/.legacy-unsupported/parse-delete.test.ts",
		"test/.legacy-unsupported/parse-drop-schema.test.ts",
		"test/.legacy-unsupported/parse-drop-table.test.ts",
		"test/.legacy-unsupported/parse-expression-type-casts.test.ts",
		"test/.legacy-unsupported/parse-expression.test.ts",
		"test/.legacy-unsupported/parse-insert.test.ts",
		"test/.legacy-unsupported/parse-select-join-on.test.ts",
		"test/.legacy-unsupported/parse-select.test.ts",
		"test/.legacy-unsupported/parse-update.test.ts",
		"test/.legacy-unsupported/parse-where-expression.test.ts",
		"test/.legacy-unsupported/right-join-full-outer-join.test.ts",
		"test/.legacy-unsupported/scalar-types-database-shape.test.ts",
		"test/.legacy-unsupported/scope-shadowing.test.ts",
		"test/framework/split-sql-token-statements.test.ts",
		"test/framework/sql-lexer.test.ts",
		"test/framework/tsgo-test-failing-output.test.ts",
		"test/framework/type-test-utils.test.ts",
		"test/.legacy-unsupported/window-functions.test.ts"
	],
	"exclude": ["test/**/*.ts", "examples", "packages"],
	"compilerOptions": {
		// File Layout
		// "rootDir": "./src",
		// "outDir": "./dist",
		// Environment Settings
		// See also https://aka.ms/tsconfig/module
		"module": "nodenext",
		"target": "esnext",
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"noEmit": true,
		// For nodejs:
		// "lib": ["esnext"],
		// "types": ["node"],
		// and npm install -D @types/node
		// Other Outputs
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"allowJs": true,
		// Stricter Typechecking Options
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		// Style Options
		// "noImplicitReturns": true,
		// "noImplicitOverride": true,
		// "noUnusedLocals": true,
		// "noUnusedParameters": true,
		// "noFallthroughCasesInSwitch": true,
		// "noPropertyAccessFromIndexSignature": true,
		// Recommended Options
		"strict": true,
		"jsx": "react-jsx",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force",
		"skipLibCheck": true
	}
}
