{
	"include": ["**/*.ts", ".automation/**/*.ts"],
	"exclude": ["test/**/*.ts", "examples", "packages", "src/gram"],
	"compilerOptions": {
		"module": "nodenext",
		"target": "esnext",
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"allowJs": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"strict": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force",
		"skipLibCheck": true
	}
}
